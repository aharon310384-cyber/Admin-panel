// ЦЕЛЕВАЯ СХЕМА v2 — ЧЕРНОВИК для ревью (на основе опросников 2.0–2.5).
// НЕ применяется автоматически. После согласования заменит prisma/schema.prisma.
// Чистые имена таблиц (без исторического маппинга Order↔Product).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"] // для будущего деплоя на Linux/Timeweb
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  WAREHOUSE // склад (Фаза 2)
}

// Справочник видов доставки (заменил enum DeliveryType).
// Значения-коды: AIR, SEA, TRAIN, TRUCK. Привязка к Order/Parcel/ShippingTariff по code.
model DeliveryMethod {
  code      String   @id // AIR | SEA | TRAIN | TRUCK
  nameRu    String
  nameEn    String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders  Order[]
  parcels Parcel[]
  tariffs ShippingTariff[]
}

// Статусы ЗАКАЗА-строки (до оформления в посылку). RETURNED/UTILIZED — сквозные.
enum OrderStatus {
  NEW                        // Новый
  IN_RECEIVING_QUEUE         // В очереди на приём
  RECEIVED                   // Принят на склад
  RECEIVED_WITH_DISCREPANCY  // Принят с несоответствием (ветка)
  FORMED                     // Оформлен на отправку (ушёл в посылку)
  RETURNED                   // Возвращён (сквозной)
  UTILIZED                   // Утилизировано (сквозной)
}

// Статусы ПОСЫЛКИ (после оформления). RETURNED/UTILIZED — сквозные.
enum ParcelStatus {
  FORMED         // Оформлена на отправку
  ASSEMBLED      // Собран
  PACKED         // Упакован
  READY_TO_SHIP  // Готова к отправке (формируется квитанция)
  SHIPPED        // Отправлена
  DELIVERED      // Доставлена
  RETURNED       // Возвращён (сквозной)
  UTILIZED       // Утилизировано (сквозной)
}

enum ServicePricingType {
  PER_KG    // за кг (от расчётного веса посылки)
  PER_ORDER // за заказ-строку (детальная проверка 2$)
  PERCENT   // % от стоимости товаров (страховка 2–10)
  MANUAL    // по факту (усиленная упаковка, доставка до склада)
  REQUEST   // по запросу: цена не называется (закупка под ключ); в расчёт посылки не входит
}

enum PaymentTiming {
  BEFORE   // оплата до отправки (РФ/EMS/КЗ/БР)
  FLEXIBLE // до/после (Узб/Укр/Молд)
}

enum LostItemStatus {
  LOST        // Потеряшка
  TRANSFERRED // Передано на приём
  UTILIZED    // Утилизировано
}

// Статусы задачи на формирование посылки. «В работе» = IN_PROGRESS.
enum ParcelTaskStatus {
  NEW         // Создана
  IN_PROGRESS // В работе
  ASSEMBLED   // Собрана
  PACKED      // Упакована
  WEIGHED     // Взвешена
  COMPLETED   // Посылка сформирована
  CANCELED    // Отменена
}

enum ReceivingCondition {
  INTACT  // Целый
  DAMAGED // Повреждён
}

enum Currency {
  CNY
  USD
}

enum AgentPayoutStatus {
  PENDING  // Ожидает оплаты
  PAID     // Оплачена
  CANCELED // Отменена
}

enum TopUpRequestStatus {
  PENDING  // Ожидает оплаты
  PAID     // Оплачена
  CANCELED // Отменена
}

// Основание изменения долга клиента
enum LedgerReason {
  PARCEL_CHARGE // начисление за посылку
  PAYMENT       // оплата (распределение)
  ADJUSTMENT    // ручная корректировка
}

// ─────────────────────────── КОМПАНИИ ───────────────────────────

/// Компания — чей бренд показывает система: название, логотип, сайт, контакты, тексты Telegram.
/// Всё о компании — здесь, а не в коде (docs/product/будущее.md, раздел 0). Меняется в «Администрирование → Компании».
/// Бренд админки — у компании с adminBrand, бренд кабинета клиента и Telegram — у компании с cabinetBrand.
model Company {
  id                String   @id @default(cuid())
  code              String   @unique // латиницей, для начальных данных и связей: MYCARGO
  name              String   // как пишется в интерфейсе
  legalName         String?  // полное юридическое название
  tagline           String?  // коротко о компании — в описании страниц кабинета («посылки из Китая»)
  siteUrl           String?  // сайт: ссылка с логотипа
  trackingUrl       String?  // страница отслеживания посылки на сайте — кнопка «Отследить» в кабинете
  tariffsUrl        String?  // страница тарифов на сайте — ссылка со страниц тарифов
  phone             String?
  email             String?
  telegram          String?  // контакт в Telegram для связи (@username)
  address           String?
  telegramGreeting  String?  // приветствие бота, когда клиент пишет ему впервые
  telegramSignature String?  // подпись под уведомлениями клиенту
  logo              Bytes?   // логотип с надписью — шапка кабинета
  logoType          String?  // image/png, image/jpeg, image/webp
  icon              Bytes?   // знак без надписи — рядом с названием (вход, админка)
  iconType          String?
  adminBrand        Boolean  @default(false) // её бренд — в админке (склад); такая компания одна
  cabinetBrand      Boolean  @default(false) // её бренд — в кабинете клиента и Telegram; такая компания одна
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedBy         String?

  shippingTariffs ShippingTariff[]
  serviceTariffs  ServiceTariff[]
  rateChanges     ExchangeRateChange[]
}

// ─────────────────────────── СОТРУДНИКИ ───────────────────────────

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      UserRole  @default(MANAGER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orderStatusChanges  OrderStatusHistory[]
  parcelStatusChanges ParcelStatusHistory[]
  localDeliveries     LocalDelivery[]
  lostItems           LostItem[]
  ordersCreated       Order[]               @relation("OrderAuthor")
  recipientsCreated   Recipient[]           @relation("RecipientAuthor")

  // документы, которые оформил сотрудник
  sortings           Sorting[]
  receivings         Receiving[]
  placements         Placement[]
  parcelTasks        ParcelTask[]
  assemblies         Assembly[]
  packings           Packing[]
  weighings          Weighing[]
  boxes              Box[]
  manifests          Manifest[]
  awbs               Awb[]
  agentInvoices      AgentInvoice[]
  agentPayouts       AgentPayout[]
  topUpRequests      TopUpRequest[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  ledgerEntries      ClientLedger[]

  interfaceSettings UserInterfaceSettings?
  objectVersions    ObjectVersion[]
  rateChanges       ExchangeRateChange[]
}

/// Настройки интерфейса сотрудника — как «Настройка панелей» в 1С. Свои у каждого.
model UserInterfaceSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  panels    Json?    // где какие панели: { top: [...], left: [...], right: [...], bottom: [...] }; пусто — стандартные
  favorites Json?    // избранное: [{ path, href, title }]
  history   Json?    // история: [{ path, href, title, at }], новые первыми
  forms     Json?    // настройка форм: { [ключ окна]: { hidden: [скрытые части] } }; пусто — все части видны
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── СПРАВОЧНИКИ ───────────────────────────

model Country {
  code              String   @id // ISO
  nameRu            String
  nameEn            String
  phoneCode         String?  // международный телефонный код (напр. "+34")
  phoneNumberMin    Int?     // мин. число цифр национального номера (без кода страны)
  phoneNumberMax    Int?     // макс. число цифр национального номера (без кода страны)
  postalCodeRegex   String?
  postalCodeExample String?
  aliases           String?  // альтернативные названия/транслиты через запятую (для поиска)
  isEu              Boolean  @default(false) // член ЕС — для таможенной пошлины ЕС €3/позиция
  // Фаза 2: таможенные лимиты
  dutyFreeLimitUsd  Decimal?
  dutyFreeLimitKg   Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recipients Recipient[]

  @@index([nameRu])
}

model ProductName {
  id        String    @id @default(cuid())
  code      String    @unique
  nameRu    String
  nameEn    String?
  nameCn    String?
  category  String?   // секция (текст) — дублирует parent.nameRu для быстрого поиска/показа
  hsCode        String?   // ТН ВЭД / HS6 — Фаза 2 (таможня ЕС €3/позиция)
  hsDescription String?   // официальное описание EU CN 2026 для hsCode (сверка с базой ЕС)
  parentId      String?   // ссылка на секцию (у секций null, у позиций — id секции)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent   ProductName?  @relation("ProductNameTree", fields: [parentId], references: [id])
  children ProductName[] @relation("ProductNameTree")
  orders   Order[]

  @@index([nameRu])
  @@index([category])
  @@index([parentId])
}

// Тарифы доставки — только здесь, не в коде. Правятся в «Логистика → Тарифы».
// Тариф посылки выбирается по стране получателя и виду доставки: countryCodes + deliveryType.
model ShippingTariff {
  id             String        @id @default(cuid())
  companyId      String?       // чей тариф; пусто — только до переноса тарифов (db:upgrade)
  company        Company?      @relation(fields: [companyId], references: [id])
  section        String?       // раздел на странице тарифов: «Основные направления», «EMS»
  direction      String        // название направления: «Россия (авто)», «Европа и Грузия»
  countryCodes   String[]      @default([]) // страны направления (ISO), по ним выбирается тариф посылки
  deliveryType   String
  deliveryMethod DeliveryMethod @relation(fields: [deliveryType], references: [code])
  cargoType      String?       // уточнение: «до 2 кг», «порошки, жидкости, батарейки»
  deliveryTarget String?       // «до двери/отделения»
  pricePerKgUsd  Decimal       // ставка $/кг
  handlingFeeUsd Decimal       @default(0) // оформление $
  onRequest      Boolean       @default(false) // цена по запросу: показывается, но в расчёт посылки не берётся
  minDays        Int?
  maxDays        Int?
  paymentTiming  PaymentTiming @default(BEFORE)
  volumetricDivisor Int?       // Фаза 2 (делитель объёмного веса)
  minWeightKg    Decimal?      // Фаза 2 (минимальный вес)
  sortOrder      Int           @default(0)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId])
  @@index([direction])
  @@index([deliveryType])
  @@index([active])
}

// Цены услуг — только здесь, не в коде. Код услуги связан с отметками в заказе и посылке, поэтому он
// постоянный и пока общий для всех компаний; правятся название, описание и цена.
model ServiceTariff {
  code               String             @id // напр. CONSOLIDATION
  companyId          String?            // чья услуга; пусто — только до переноса тарифов (db:upgrade)
  company            Company?           @relation(fields: [companyId], references: [id])
  name               String
  description        String?            // пояснение на странице тарифов
  pricingType        ServicePricingType
  value              Decimal?           // 0.3 / 0.5 / 1.0 / 2.0 (для MANUAL — null)
  percentMin         Decimal?           // для PERCENT (страховка 2)
  percentMax         Decimal?           // для PERCENT (страховка 10)
  selectableByClient Boolean            @default(false) // true только у «Детальная проверка»
  inPriceList        Boolean            @default(true)  // показывать на странице тарифов
  active             Boolean            @default(true)
  sortOrder          Int                @default(0)

  parcelServices ParcelService[]
}

// Курсы — только здесь («Финансы → Курс»), без запасного числа в коде: пусто — курс не задан, и расчёты просят его задать.
model FinanceSettings {
  id                    String   @id @default(cuid())
  exchangeRateCnyPerUsd Decimal? // курс ¥ за $
  // Таможенная пошлина ЕС (Council Reg. (EU) 2026/382, €3/позиция до 01.07.2028)
  exchangeRateCnyPerEur Decimal? // курс EUR в юанях (¥ за €) — для пересчёта пошлины ЕС
  euDutyEnabled         Boolean  @default(true)  // мастер-выключатель меры
  euDutyPassToClient    Boolean  @default(true)  // включать ли пошлину в счёт клиента
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

enum RateCurrency {
  USD // курс ¥ за $
  EUR // курс ¥ за €
}

/// Регистр курсов — история изменения курсов в «Финансы → Курс»: когда, кто, с какого значения на какое.
/// Запись появляется при каждом сохранении, где курс поменялся; записи не правятся и не удаляются.
model ExchangeRateChange {
  id          String       @id @default(cuid())
  companyId   String?      // чей курс; пусто — общий курс системы («Финансы → Курс» пока один на все компании)
  company     Company?     @relation(fields: [companyId], references: [id])
  currency    RateCurrency
  oldRate     Decimal?     // было; пусто — курс не был задан
  newRate     Decimal?     // стало
  note        String?      // пояснение: «курс на момент запуска журнала»
  changedAt   DateTime     @default(now())
  changedById String?      // кто поменял; пусто — неизвестно (до журнала)
  changedBy   User?        @relation(fields: [changedById], references: [id])

  @@index([changedAt])
}

// ─────────────────────────── КЛИЕНТЫ / ПОЛУЧАТЕЛИ ───────────────────────────

model Customer {
  id               String    @id @default(cuid())
  code             String?   @unique
  clientCode       String?
  name             String
  lastName         String?
  firstName        String?
  middleName       String?
  email            String?   @unique
  phone            String?
  country          String?
  city             String?
  address          String?
  // вход в кабинет
  telegramUserId   String?   @unique
  telegramChatId   String?
  telegramUsername String?
  telegramLinkedAt DateTime?
  passwordHash     String?
  // Фаза 2: WeChat
  wechatOpenId     String?   @unique
  wechatUnionId    String?
  wechatLinkedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  recipients      Recipient[]
  orders          Order[]
  parcels         Parcel[]
  localDeliveries LocalDelivery[]
  lostItems       LostItem[]
  sortings        Sorting[]
  parcelTasks     ParcelTask[]
  topUpRequests   TopUpRequest[]
  payments        Payment[]
  ledgerEntries   ClientLedger[]

  @@index([code])
  @@index([phone])
  @@index([telegramUserId])
}

model Recipient {
  id          String    @id @default(cuid())
  customerId  String
  name        String    // отображаемое ФИО (собирается из lastName/firstName/middleName)
  firstName   String?
  lastName    String?
  middleName  String?
  phone       String?
  phoneDialCode String? // телефонный код страны (напр. "+34"), подтягивается из справочника
  countryCode String?
  country     String?
  city        String?
  address     String?
  postalCode  String?
  // документы
  passportSeries   String?
  passportNumber   String?
  passportIssuedAt DateTime? // дата выдачи
  passportIssuedBy String?   // кем выдан
  passportExpiry   DateTime? // дата окончания
  pinfl          String?   // ПИНФЛ (14 цифр, Узбекистан)
  // кто внёс получателя
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer       Customer @relation(fields: [customerId], references: [id])
  countryRef     Country? @relation(fields: [countryCode], references: [code])
  author         User?    @relation("RecipientAuthor", fields: [authorId], references: [id])
  orders         Order[]
  parcels        Parcel[]

  @@index([customerId])
  @@index([authorId])
}

// ─────────────────────────── ЗАКАЗ = СТРОКА = ТОВАР ───────────────────────────

model Order {
  id           String        @id @default(cuid())
  number       String?       @unique // номер документа ZK-000001 (lib/document-numbers.ts)
  customerId   String        // владелец/плательщик
  recipientId  String?       // куда везём (переносится в посылку при оформлении)
  deliveryType   String?
  deliveryMethod DeliveryMethod? @relation(fields: [deliveryType], references: [code])
  // товар
  productNameId          String?
  productNameText        String?  // снимок/свободный ввод
  category               String?
  hsCode                 String?  // Фаза 2
  declaredValueUsd       Decimal? // объявленная стоимость = unitPrice × quantity
  trackNumber            String?  // входящий трек-номер (китайская служба), НЕ уникален
  quantity               Int      @default(1)
  unitPriceCny           Decimal?
  unitPriceUsd           Decimal?
  // вес на строке (Z5)
  actualWeightKg         Decimal?
  volumetricWeightKg     Decimal?
  // услуга клиента
  detailedCheckRequested Boolean  @default(false) // «Детальная проверка и фотоотчёт»
  keepOriginalPackaging  Boolean  @default(true)  // «Оставить оригинальную упаковку» (по умолчанию включено)
  // услуги посылки, выбранные на строке заказа (при оформлении переходят в посылку, OR по заказам)
  consolidationRequested  Boolean @default(false) // «Консолидация» 0.3 $/кг
  compactPackRequested    Boolean @default(false) // «Компактная упаковка» 0.5 $/кг
  standardCheckRequested  Boolean @default(false) // «Стандартная проверка» 1 $/кг
  reinforcedPackRequested Boolean @default(false) // «Усиленная упаковка» — сумму задаёт админ на посылке
  productUrl             String?
  imageUrl               String?
  // комментарий клиента к заказу (пожелания/примечания; ИИ тоже может заполнить); клиент видит его в кабинете
  customerComment        String?
  internalComment        String? // внутренний комментарий: видят только сотрудники
  // процесс
  status       OrderStatus @default(NEW)
  sortingId    String?     // документ «Сортировка» коробки
  receivingId  String?     // документ «Приём заказа» коробки
  parcelTaskId String?     // задача на формирование посылки (заполняется при оформлении)
  parcelId     String?     // заполняется при оформлении
  authorId     String?     // кто создал заказ (заполняется автоматически)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  customer        Customer             @relation(fields: [customerId], references: [id])
  recipient       Recipient?           @relation(fields: [recipientId], references: [id])
  productName     ProductName?         @relation(fields: [productNameId], references: [id])
  parcel          Parcel?              @relation(fields: [parcelId], references: [id])
  author          User?                @relation("OrderAuthor", fields: [authorId], references: [id])
  sorting         Sorting?             @relation(fields: [sortingId], references: [id])
  receiving       Receiving?           @relation(fields: [receivingId], references: [id])
  parcelTask      ParcelTask?          @relation(fields: [parcelTaskId], references: [id])
  statusHistory   OrderStatusHistory[]
  localDeliveries LocalDelivery[]
  assemblyItems   AssemblyItem[]

  @@index([customerId])
  @@index([recipientId])
  @@index([sortingId])
  @@index([receivingId])
  @@index([parcelTaskId])
  @@index([parcelId])
  @@index([status])
  @@index([trackNumber])
  @@index([authorId])
}

// ─────────────────────────── ПОСЫЛКА ───────────────────────────

model Parcel {
  id           String        @id @default(cuid())
  number       String        @unique // PS-000001 (lib/document-numbers.ts); номер вида SM3956US — у задачи
  parcelTaskId String?       @unique // задача на формирование посылки
  boxId        String?       // короб (комплектация коробов)
  customerId   String
  recipientId  String?
  deliveryType   String?
  deliveryMethod DeliveryMethod? @relation(fields: [deliveryType], references: [code])
  status       ParcelStatus  @default(FORMED)
  // веса и габариты
  actualWeightKg     Decimal?
  volumetricWeightKg Decimal? // считается из габаритов ÷ делитель тарифа (или 6000)
  billableWeightKg   Decimal? // расчётный (по умолчанию max(факт, объёмный), ручной перебор)
  lengthCm           Decimal? // габарит Д
  widthCm            Decimal? // габарит Ш
  heightCm           Decimal? // габарит В
  // расчёт
  exchangeRateCnyPerUsd Decimal  // курс ¥ за $, фиксируется при расчёте посылки и потом не меняется
  shippingCostUsd       Decimal? // Отправка = billableWeightKg × ставка
  discountPercent       Decimal? // скидка % от итога
  declaredValueUsd      Decimal? // стоимость товаров внутри посылки, $ (из Excel — колонка «стоимость товаров»)
  // Таможенная пошлина ЕС — не наша услуга, не попадает под скидку
  customsDutyEur        Decimal? // €3 × число тарифных позиций (если применимо)
  customsDutyUsd        Decimal? // конвертация пошлины в $ по курсу EUR
  customsDutyLineCount  Int?     // сколько тарифных позиций (типов товара) учтено
  customsDutyManualLines Int?    // ручной перебор числа позиций (null = авто по составу)
  customsDutyPassToClient Boolean? // переопределение «в счёт клиента» на уровне посылки (null = как в настройках)
  totalUsd              Decimal  @default(0)
  totalCny              Decimal  @default(0)
  // оплата
  isPaid        Boolean       @default(false)
  paidAt        DateTime?
  paymentTiming PaymentTiming @default(BEFORE) // из тарифа
  // отслеживание
  trackingNumber String?  // трек-номер посылки (международный)
  notes          String?
  internalComment String? // внутренний комментарий: видят только сотрудники
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  customer        Customer                @relation(fields: [customerId], references: [id])
  recipient       Recipient?              @relation(fields: [recipientId], references: [id])
  parcelTask      ParcelTask?             @relation(fields: [parcelTaskId], references: [id])
  box             Box?                    @relation(fields: [boxId], references: [id])
  orders          Order[]                 // строки-заказы внутри
  services        ParcelService[]
  statusHistory   ParcelStatusHistory[]
  allocationItems PaymentAllocationItem[]
  ledgerEntries   ClientLedger[]
  tracking        ParcelTracking?
  finance         ParcelFinance?

  @@index([customerId])
  @@index([boxId])
  @@index([recipientId])
  @@index([status])
  @@index([number])
  @@index([isPaid])
}

model ParcelService {
  id          String  @id @default(cuid())
  parcelId    String
  serviceCode String
  name        String  // снимок названия услуги
  baseValue   Decimal? // от чего считали (вес/кол-во/стоимость)
  priceUsd    Decimal  @default(0)
  priceCny    Decimal  @default(0)

  parcel  Parcel        @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  service ServiceTariff @relation(fields: [serviceCode], references: [code])

  @@index([parcelId])
}

// ─────────────────────────── РЕГИСТРЫ ───────────────────────────

// «Доставка до склада» (локальная). Несколько записей → их сумма одной строкой в расчёт посылки.
model LocalDelivery {
  id               String   @id @default(cuid())
  orderId          String?  // привязка к строке-заказу (по треку Китая)
  customerId       String?
  parcelNumber     String?  // номер посылки
  trackNumberChina String?
  amountCny        Decimal
  amountUsd        Decimal
  exchangeRate     Decimal
  authorId         String
  note             String?
  createdAt        DateTime @default(now())

  order    Order?    @relation(fields: [orderId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  author   User      @relation(fields: [authorId], references: [id])

  @@index([orderId])
  @@index([parcelNumber])
}

// Потеряшки (Фаза 2) — заложено заранее.
model LostItem {
  id           String         @id @default(cuid())
  trackNumber  String
  weightKg     Decimal?
  customerId   String?
  parcelNumber String?
  note         String?
  photoUrl     String?
  status       LostItemStatus @default(LOST)
  authorId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  author   User      @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([trackNumber])
}

// ─────────────────────────── ДОКУМЕНТООБОРОТ ───────────────────────────
// Цепочка документов и правила: docs/product/документооборот.md.
// У всех документов: номер с префиксом (lib/document-numbers.ts), автор, примечание, мягкое удаление.
// АРМы, которые создают документы этапов и переключают статусы, — следующий этап.

/// Последний выданный номер по каждому префиксу документа
model DocumentCounter {
  prefix    String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Ячейка хранения на складе (для раскладки)
model StorageCell {
  id        String   @id @default(cuid())
  code      String   @unique
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements Placement[]
}

/// Агент (подрядчик): авиаперевозчик, брокер, служба доставки
model Agent {
  id        String    @id @default(cuid())
  name      String
  kind      String?
  contacts  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoices AgentInvoice[]

  @@index([name])
}

// ── Склад: коробка поступила. Документы — по коробке (входящему трек-номеру),
//    охватывают все заказы-строки из неё (Order.sortingId / Order.receivingId).

/// Сортировка (SR): коробку опознали по маркировке и отнесли к клиенту
model Sorting {
  id               String    @id @default(cuid())
  number           String    @unique
  trackNumber      String?   // входящий трек-номер коробки
  customerId       String?   // определённый клиент
  clientIdentified Boolean   @default(false)
  note             String?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  customer  Customer? @relation(fields: [customerId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  orders    Order[]

  @@index([trackNumber])
  @@index([customerId])
  @@index([createdAt])
}

/// Приём заказа (PR)
model Receiving {
  id          String             @id @default(cuid())
  number      String             @unique
  trackNumber String?            // входящий трек-номер коробки
  placesCount Int                @default(1)
  weightKg    Decimal?
  condition   ReceivingCondition @default(INTACT)
  photoUrl    String?
  note        String?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  createdBy User       @relation(fields: [createdById], references: [id])
  orders    Order[]
  placement Placement?

  @@index([trackNumber])
  @@index([createdAt])
}

/// Раскладка (RS): принятую коробку положили в ячейку хранения
model Placement {
  id          String    @id @default(cuid())
  number      String    @unique
  receivingId String    @unique
  cellId      String
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  receiving Receiving   @relation(fields: [receivingId], references: [id])
  cell      StorageCell @relation(fields: [cellId], references: [id])
  createdBy User        @relation(fields: [createdById], references: [id])

  @@index([cellId])
}

// ── Склад: из заказов формируют посылку

/// Задача на формирование посылки. Номер как в Excel: код клиента + сквозной номер + страна (SM3956US).
/// Приписки к номеру из Excel («01 DHL», «Sea») — в note.
model ParcelTask {
  id                 String           @id @default(cuid())
  number             String           @unique
  status             ParcelTaskStatus @default(NEW)
  customerId         String
  destinationCountry String?
  note               String?
  internalComment    String? // внутренний комментарий: видят только сотрудники
  createdById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  customer  Customer  @relation(fields: [customerId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  orders    Order[]
  assembly  Assembly?
  packing   Packing?
  weighing  Weighing?
  parcel    Parcel?

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

/// Сборка (SB): какие заказы задачи собраны и все ли найдены
model Assembly {
  id           String    @id @default(cuid())
  number       String    @unique
  parcelTaskId String    @unique
  allFound     Boolean   @default(false)
  note         String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  parcelTask ParcelTask     @relation(fields: [parcelTaskId], references: [id])
  createdBy  User           @relation(fields: [createdById], references: [id])
  items      AssemblyItem[]
}

/// Строка сборки: заказ и отметка, найден ли он
model AssemblyItem {
  id         String  @id @default(cuid())
  assemblyId String
  orderId    String
  found      Boolean @default(true)

  assembly Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id])

  @@unique([assemblyId, orderId])
  @@index([orderId])
}

/// Упаковка (UP)
model Packing {
  id            String    @id @default(cuid())
  number        String    @unique
  parcelTaskId  String    @unique
  packagingType String?
  placesCount   Int       @default(1)
  note          String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  parcelTask ParcelTask @relation(fields: [parcelTaskId], references: [id])
  createdBy  User       @relation(fields: [createdById], references: [id])
}

/// Взвешивание (VZ)
model Weighing {
  id                 String    @id @default(cuid())
  number             String    @unique
  parcelTaskId       String    @unique
  weightKg           Decimal
  lengthCm           Decimal?
  widthCm            Decimal?
  heightCm           Decimal?
  volumetricWeightKg Decimal?
  note               String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  parcelTask ParcelTask @relation(fields: [parcelTaskId], references: [id])
  createdBy  User       @relation(fields: [createdById], references: [id])
}

// ── Отправка и расходы

/// Комплектация коробов (KR): короб, в который уложены посылки (Parcel.boxId)
model Box {
  id          String    @id @default(cuid())
  number      String    @unique
  manifestId  String?
  weightKg    Decimal?
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  manifest  Manifest? @relation(fields: [manifestId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  parcels   Parcel[]

  @@index([manifestId])
}

/// Реестр отправки (RO): какие коробы уходят одной отправкой
model Manifest {
  id                 String    @id @default(cuid())
  number             String    @unique
  shipDate           DateTime?
  destinationCountry String?
  note               String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  createdBy User  @relation(fields: [createdById], references: [id])
  boxes     Box[]
  awbs      Awb[]

  @@index([shipDate])
}

/// Документы AWB (AW). awbNumber — номер авианакладной у перевозчика
model Awb {
  id            String    @id @default(cuid())
  number        String    @unique
  manifestId    String
  awbNumber     String?
  carrier       String?
  flightNumber  String?
  departureDate DateTime?
  note          String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  manifest  Manifest       @relation(fields: [manifestId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  invoices  AgentInvoice[]

  @@index([manifestId])
  @@index([awbNumber])
}

/// Счёт на оплату услуг (SA): входящий счёт агента по AWB
model AgentInvoice {
  id             String    @id @default(cuid())
  number         String    @unique
  agentId        String
  awbId          String
  externalNumber String?   // номер счёта у агента
  invoiceDate    DateTime?
  amount         Decimal
  currency       Currency  @default(CNY)
  note           String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  agent     Agent         @relation(fields: [agentId], references: [id])
  awb       Awb           @relation(fields: [awbId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  payouts   AgentPayout[]

  @@index([agentId])
  @@index([awbId])
}

/// Заявка на выплату агенту (VA). Несколько заявок на счёт — частичная оплата
model AgentPayout {
  id             String            @id @default(cuid())
  number         String            @unique
  agentInvoiceId String
  amount         Decimal
  currency       Currency          @default(CNY)
  status         AgentPayoutStatus @default(PENDING)
  paidAt         DateTime?
  note           String?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  agentInvoice AgentInvoice @relation(fields: [agentInvoiceId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([agentInvoiceId])
  @@index([status])
}

// ── Деньги клиента

/// Заявка на пополнение баланса клиента (PB)
model TopUpRequest {
  id          String             @id @default(cuid())
  number      String             @unique
  customerId  String
  amount      Decimal
  currency    Currency           @default(CNY)
  status      TopUpRequestStatus @default(PENDING)
  note        String?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  customer  Customer  @relation(fields: [customerId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  payments  Payment[]

  @@index([customerId])
  @@index([status])
}

/// Приход ДС (PD): поступившие от клиента деньги
model Payment {
  id             String    @id @default(cuid())
  number         String    @unique
  customerId     String
  topUpRequestId String?
  amount         Decimal
  currency       Currency  @default(CNY)
  method         String?   // Alipay, WeChat, банк, наличные…
  receivedAt     DateTime  @default(now())
  note           String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  customer     Customer            @relation(fields: [customerId], references: [id])
  topUpRequest TopUpRequest?       @relation(fields: [topUpRequestId], references: [id])
  createdBy    User                @relation(fields: [createdById], references: [id])
  allocations  PaymentAllocation[]

  @@index([customerId])
  @@index([topUpRequestId])
  @@index([receivedAt])
}

/// Распределение оплат по посылкам (RP): какая часть прихода закрывает какую посылку.
/// Когда распределённые суммы покрывают посылку, она отмечается оплаченной (lib/parcel-payment.ts).
model PaymentAllocation {
  id          String    @id @default(cuid())
  number      String    @unique
  paymentId   String
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  payment       Payment                 @relation(fields: [paymentId], references: [id])
  createdBy     User                    @relation(fields: [createdById], references: [id])
  items         PaymentAllocationItem[]
  ledgerEntries ClientLedger[]

  @@index([paymentId])
}

/// Строка распределения: посылка и сумма в валюте прихода
model PaymentAllocationItem {
  id           String  @id @default(cuid())
  allocationId String
  parcelId     String
  amount       Decimal

  allocation PaymentAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  parcel     Parcel            @relation(fields: [parcelId], references: [id])

  @@unique([allocationId, parcelId])
  @@index([parcelId])
}

/// Изменение долга клиента (DK): amount > 0 — долг вырос, amount < 0 — уменьшился.
/// Долг клиента = сумма строк.
model ClientLedger {
  id                  String       @id @default(cuid())
  number              String       @unique
  customerId          String
  amount              Decimal
  currency            Currency     @default(CNY)
  reason              LedgerReason
  parcelId            String?
  paymentAllocationId String?
  note                String?
  createdById         String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  customer          Customer           @relation(fields: [customerId], references: [id])
  parcel            Parcel?            @relation(fields: [parcelId], references: [id])
  paymentAllocation PaymentAllocation? @relation(fields: [paymentAllocationId], references: [id])
  createdBy         User               @relation(fields: [createdById], references: [id])

  @@index([customerId])
  @@index([parcelId])
  @@index([paymentAllocationId])
}

// ─────────────────────────── ИСТОРИЯ ИЗМЕНЕНИЙ ───────────────────────────

/// Версии документов — «История изменений», как версионирование объектов в 1С.
model ObjectVersion {
  id        String   @id @default(cuid())
  entity    String   // "order" | "parcel"
  entityId  String
  version   Int      // 1, 2, 3… по каждому документу
  authorId  String?
  comment   String?  // «Создан», «Изменён», «Принят на склад», «Оформлен в посылку», «Помечен на удаление»…
  data      Json     // снимок: { fields: [{ key, label, value }], tables: [{ key, label, columns: [...], rows: [[...]] }] }, значения уже строками для показа
  createdAt DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id])

  @@unique([entity, entityId, version])
  @@index([entity, entityId])
}

// ─────────────────────────── ИСТОРИЯ СТАТУСОВ ───────────────────────────

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedBy String
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [changedBy], references: [id])

  @@index([orderId])
}

model ParcelStatusHistory {
  id        String       @id @default(cuid())
  parcelId  String
  status    ParcelStatus
  changedBy String?      // пусто — статус поставила система (отслеживание 17TRACK)
  note      String?
  createdAt DateTime     @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [changedBy], references: [id])

  @@index([parcelId])
}

/// Отслеживание посылки в 17TRACK: номер на слежении и последнее известное состояние.
/// Пишет lib/tracking.ts; посылку «Доставлена» ставит сама, сложные случаи помечает problem.
model ParcelTracking {
  parcelId     String    @id
  number       String    // номер на слежении: трек-номер посылки без пробелов, заглавными
  carrier      Int?      // код перевозчика в 17TRACK
  carrierName  String?
  registeredAt DateTime? // поставлен на слежение; пусто — не поставлен (причина в error)
  status       String?   // основной статус 17TRACK: NotFound, InfoReceived, InTransit, AvailableForPickup, OutForDelivery, DeliveryFailure, Delivered, Exception, Expired
  subStatus    String?   // уточнение статуса, напр. Exception_Returning
  event        String?   // последнее событие
  location     String?
  eventAt      DateTime?
  events       Json?     // события: [{ at, text, location }], новые первыми
  problem      Boolean   @default(false) // нужна проверка человеком: возврат, не вручена, таможня, нет данных
  error        String?   // последняя ошибка 17TRACK по номеру
  fallbackAt   DateTime? // переставлен на запасного перевозчика (TrackingSettings.fallbackCarrier) — второй раз не переставляем
  checkedAt    DateTime?
  updatedAt    DateTime  @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([number])
  @@index([problem])
}

/// Настройки отслеживания посылок (17TRACK). Одна запись.
/// Себестоимость и выручка посылки — ТОЛЬКО для сотрудников. Отдельная таблица, чтобы эти суммы
/// не попали в кабинет клиента вместе с посылкой: кабинет её не читает.
model ParcelFinance {
  parcelId       String   @id
  carrierCostCny Decimal? // стоимость отправки для нас, ¥ (из Excel — колонка «стоимость отправки для нас»)
  revenueCny     Decimal? // выручка, ¥
  updatedAt      DateTime @updatedAt
  updatedBy      String?

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
}

/// Загрузка из Excel: в какой колонке листа что лежит (буквы Excel: {"taskNumber":"B","info":"D",…}).
/// Строку копируют начиная с колонки номера строки (taskNumber). Колонки — настройка, а не код: у каждой компании свой лист.
model ExcelImportSettings {
  id        String   @id @default(cuid())
  columns   Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model TrackingSettings {
  id         String    @id @default(cuid())
  apiKey     String?   // ключ API 17TRACK (заголовок 17token); в браузер не отдаётся
  lang       String    @default("ru") // язык событий у 17TRACK (бесплатно — если язык даёт сам перевозчик)
  // Запасной перевозчик: номер с этой приставкой 17TRACK сам не определил или за fallbackAfterHours ничего не нашёл —
  // переставить на этого перевозчика (смена перевозчика тратит ещё 1 номер квоты)
  fallbackPrefixes    String? // через запятую: CK, LK, LC
  fallbackCarrier     Int?    // код перевозчика в 17TRACK
  fallbackCarrierName String?
  fallbackAfterHours  Int     @default(24)
  lastSyncAt DateTime?
  lastSync   String?   // итог последней проверки одной строкой
  updatedAt  DateTime  @updatedAt
  updatedBy  String?
}
