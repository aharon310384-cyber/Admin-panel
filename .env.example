# PostgreSQL. Локально — база из README («Быстрый старт»). На сервере адрес с паролем пишет команда postgres.
DATABASE_URL="postgresql://postmanfox:postmanfox@127.0.0.1:5432/postmanfox?schema=public"

# Секрет авторизации (openssl rand -base64 32). Клиентская сессия читает AUTH_SECRET ?? NEXTAUTH_SECRET.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Публичный URL приложения (вшивается на этапе сборки — задайте реальный домен перед docker build)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Загрузки
UPLOAD_DIR="public/uploads"

# Telegram (прод-бот, отдельный от бота для общения)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
NEXT_PUBLIC_TELEGRAM_BOT_NAME=""

# ИИ-разбор заказов (OpenRouter, OpenAI-совместимый API)
OPENROUTER_API_KEY=""
# Любой слаг модели OpenRouter, напр. moonshotai/kimi-k2 или deepseek/deepseek-chat
OPENROUTER_ORDER_MODEL="moonshotai/kimi-k2"

# Отслеживание посылок 17TRACK. Ключ API вводится в админке («Настройки»), здесь — ключ вызова по расписанию:
# на сервере его сам пишет scripts/deploy/server.sh (deploy). Без него /api/tracking/sync закрыт.
TRACKING_CRON_KEY=
# Адрес API 17TRACK — только для проверки на заглушке; по умолчанию https://api.17track.net/track/v2.4
# TRACK17_API_URL=

# Прочее
AUTH_DEBUG="false"
DEMO_ADMIN_PASSWORD="admin123"
DEMO_MANAGER_PASSWORD="manager123"
